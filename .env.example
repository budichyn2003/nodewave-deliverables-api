# Database
DATABASE_URL="postgresql://user:password@localhost:5432/deliverables?schema=public"
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/deliverables_test?schema=public"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# CORS — comma-separated list of allowed origins
FRONTEND_ORIGIN="http://localhost:3000"

# Server
PORT=3001
NODE_ENV="production"

# Seed passwords (defaults are documented in README — override in production!)
SEED_PM_PASSWORD=""
SEED_INTERNAL_PASSWORD=""
SEED_CLIENT_PASSWORD=""

# Storage: "local" (ephemeral on many hosts — files are lost on redeploy)
# or "s3" (S3-compatible; provide the vars below).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
